    <TextView android:text="@string/settings_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <EditText
        android:id="@+id/edit_user"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="text"
        android:hint="@string/settings_user_hint"/>

    <TextView android:text="@string/settings_pswd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <EditText
        android:id="@+id/edit_pswd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="textPassword"
        android:hint="@string/settings_pswd_hint"/>
 

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:background="#808080" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/settings_others"
        android:paddingHorizontal="12dp" />
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_weight="1"
        android:background="#808080" />
</LinearLayout>


    <TextView android:text="@string/settings_theme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <RadioGroup
        android:id="@+id/radio_theme"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
    <RadioButton android:id="@+id/radio_light"
        android:tag="1"
        android:text="@string/mode_light"/>
    <RadioButton android:id="@+id/radio_dark"
        android:tag="2"
        android:text="@string/mode_dark"/>
    <RadioButton android:id="@+id/radio_system"
        android:tag="-1"
        android:text="@string/mode_system"/>
    </RadioGroup>
 
    <TextView android:text="@string/settings_refresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <EditText
        android:id="@+id/edit_refresh"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"
        android:hint="@string/settings_refresh_hint"/>

    <TextView android:text="@string/settings_timeout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <EditText
        android:id="@+id/edit_timeout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:inputType="number"/>

    <TextView android:text="@string/settings_debuglevel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"/>
    <Spinner
            android:id="@+id/spinner_debuglevel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

